OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SPECIALIST_1_MODEL=anthropic/claude-sonnet-4-6
SPECIALIST_2_MODEL=openai/gpt-5.6-terra
EVALUATOR_MODEL=anthropic/claude-fable-5-1
TECHNICAL_MODEL=anthropic/claude-opus-5
# GPT-6 Astra does not support none. GPT-5.6 Terra allows none.
# low | medium | high | xhigh | max
SPECIALIST_REASONING_EFFORT=medium
EVALUATOR_REASONING_EFFORT=xhigh
TECHNICAL_REASONING_EFFORT=xhigh
TURN_TIMEOUT_SECONDS=900
# Cap on a single provider call. Keep it under TURN_TIMEOUT_SECONDS.
REQUEST_TIMEOUT_SECONDS=840
# Specialist 1/Specialist 2 agreement attempts after the first review. At least 1.
# After this many failed attempts, Evaluator asks how to proceed.
MAX_AGREEMENT_ROUNDS=3

# Chat history needs a login. Leave the password blank to let any username in.
CHAINLIT_USERNAME=jack
CHAINLIT_PASSWORD=
# Optional: set one yourself to keep sessions valid across servers.
CHAINLIT_AUTH_SECRET=

# Postgres keeps chat history across restarts. Without it, history is
# temporary sqlite at ./data/chainlit.db.
DATABASE_URL=
# auto | on | off
DATABASE_SSL=auto
