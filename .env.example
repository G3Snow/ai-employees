OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EXECUTOR_MODEL=openai/gpt-4o
EVALUATOR_MODEL=anthropic/claude-3-5-sonnet-20240620
TECHNICAL_MODEL=openai/gpt-4o
TURN_TIMEOUT_SECONDS=240
# Cap on a single provider call. Keep it under TURN_TIMEOUT_SECONDS.
REQUEST_TIMEOUT_SECONDS=180

# Chat history needs a login. Leave the password blank to let any username in.
CHAINLIT_USERNAME=jack
CHAINLIT_PASSWORD=
# Optional: set one yourself to keep sessions valid across servers.
CHAINLIT_AUTH_SECRET=

# Postgres keeps chat history across restarts. Without it, history is
# temporary sqlite at ./data/chainlit.db.
DATABASE_URL=
# auto | on | off
DATABASE_SSL=auto
