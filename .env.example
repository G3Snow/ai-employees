OPENAI_API_KEY=
ANTHROPIC_API_KEY=

EXECUTOR_MODEL=openai/gpt-6-astra
EVALUATOR_MODEL=anthropic/claude-fable-5-1
TECHNICAL_MODEL=anthropic/claude-opus-5
# GPT-6 Astra does not support none. low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=high
TURN_TIMEOUT_SECONDS=360
# Cap on a single provider call. Keep it under TURN_TIMEOUT_SECONDS.
REQUEST_TIMEOUT_SECONDS=240
# Extra Executor/Evaluator argument rounds after the first review. At least 1.
MAX_AGREEMENT_ROUNDS=2

# Chat history needs a login. Leave the password blank to let any username in.
CHAINLIT_USERNAME=jack
CHAINLIT_PASSWORD=
# Optional: set one yourself to keep sessions valid across servers.
CHAINLIT_AUTH_SECRET=

# Postgres keeps chat history across restarts. Without it, history is
# temporary sqlite at ./data/chainlit.db.
DATABASE_URL=
# auto | on | off
DATABASE_SSL=auto
